__MACOSX/
.DS_Store
__pycache__/

# Lean build artifacts. No trailing slash: a symlink named .lake, which a
# session may plant to share another checkout's cache, must be ignored too.
lean/.lake

# Agent worktrees: one checkout per concurrent session, inside the repository
# and untracked. Without this, `git add -A` stages another session's worktree
# as an embedded repository, which git reports in a hint rather than an error
# and which every gate here passes.
.claude/

# The two large generated files of the argument map (ruling F3, 2026-10-23):
# written by the plain checker run, kept by CI as artifacts and published to the
# branch `derived`; graph/versions.json records their derivation hashes.
graph/derived.json
graph/index.json
